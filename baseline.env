# ============================================================================
# VERIFIED-GOOD BASELINE CONFIG  ("May-9 quality")
# ----------------------------------------------------------------------------
# Pair this config with code commit  d5339de  (tag: good-baseline-may9).
# Verified on short_sample/HILAL-HAZM_match_B_up7.mp4 (862 frames):
#   flicker=52, wrong-merges=0, player tracks=28, team_unknown=0.0, homography_ok=0.52
#
# HOW TO USE:
#   1) cp baseline.env .env
#   2) paste your own ROBOFLOW_API_KEY (and HF_TOKEN if used) into .env
#   3) git checkout good-baseline-may9   # to use the matching code
#   4) ./run.sh <your_video.mp4>
#
# SECRETS ARE INTENTIONALLY BLANK — never commit real keys.
# ============================================================================

# ---- Secrets (fill in your own; keep .env gitignored) ----
ROBOFLOW_API_KEY=
HF_TOKEN=

# ---- Models (Roboflow-hosted; your account must have access) ----
PLAYER_MODEL_ID=footballs-player-detection-zkams-zia6c/2
# Recovered fine-tuned field model (the one the original "pure model" output used).
# It scores high, well-distributed confidence on this footage, so we use the
# original clean-point recipe: KP_CONF=0.50 below.
FIELD_MODEL_ID=football-field-detection-f07vi-it2xv/3

# ---- Runtime ----
FAST_MODE=false
DETECT_EVERY_N=1
HOMOGRAPHY_EVERY_N=1
TEAM_UPDATE_EVERY_N=1
PREPROCESS_ENABLED=true
TEAM_MODE=color
MAX_FRAMES=0
DETECT_UPSCALE=1.0
DEVICE=cpu

# ---- Tracking (BoTSort + ReID) ----
TRACK_ACTIVATION_THRESHOLD=0.25
TRACKER_TYPE=botsort
TRACK_LOW_THRESHOLD=0.10
TRACK_MIN_MATCHING_THRESHOLD=0.72
TRACK_LOST_BUFFER=70
TRACK_MIN_CONSEC_FRAMES=3
BOTSORT_GMC_METHOD=sparseOptFlow
BOTSORT_WITH_REID=true
BOTSORT_REID_MODEL=yolo11n-cls.pt
BOTSORT_PROXIMITY_THRESH=0.5
BOTSORT_APPEARANCE_THRESH=0.8

# ---- ID stabilization ----
ID_RELINK_FRAMES=120
ID_MEMORY_FRAMES=90
ID_RELINK_PX=130
ID_APP_WEIGHT=0.90
ID_AMBIGUITY_MARGIN=0.02
ID_MAX_RELINK_COST=1.45
ID_UNKNOWN_APP_PENALTY=1.10
ID_UNKNOWN_APP_MAX_GAP=12
ID_UNKNOWN_APP_MAX_SPACE_FRAC=0.85
ID_GALLERY_SIZE=36
ID_GALLERY_MIN_ADD_DIST=0.10
ID_FRAME_CONTINUITY_IOU=0.45
ID_FRAME_CONTINUITY_MARGIN=0.03
ID_SPATIAL_RESCUE_MAX_GAP=220
ID_SPATIAL_RESCUE_MARGIN=0.15
ID_SPATIAL_RESCUE_RATIO=0.70
ID_MAX_PLAYER_IDS=26
ID_HARD_REUSE_WHEN_CAPPED=true
ID_LOCK_FRAMES=12
ID_CAPPED_REUSE_MIN_GAP=8

# ---- Detection thresholds ----
DET_CONF=0.30
# FIELD_CONF is the keypoint model's inference confidence; keep it below KP_CONF
# so the field model never clips points in the band we want to retain. 0.30
# matches the original "pure model" notebook (infer at 0.3, then filter at 0.5).
FIELD_CONF=0.30
# KP_CONF filters detected keypoints before the homography solve. 0.50 is the
# original recipe, valid again now that the fine-tuned it2xv/3 model is restored:
# it produces many high-confidence, well-distributed points, so the surviving set
# is clean and well-conditioned. (0.25 was a temporary compensation for f07vi/15's
# weak confidence — not needed with this model.)
KP_CONF=0.50
MIN_AREA_RATIO_PEOPLE=0.00008
MIN_AREA_RATIO_BALL=0.00001
BALL_PAD_PX=10

# ---- Homography (STATELESS pure-model replica) ----
# The estimator now solves a plain least-squares findHomography independently
# every frame (no RANSAC, no EMA, no jump-gate, no propagation, no state machine).
# This reproduces the original stable output; the raw per-frame solve self-corrects
# within a few frames during pans instead of locking a wrong pose. The knobs below
# are retained for config compatibility but NO LONGER gate acceptance — only MIN_KP
# is honored (clamped to >=4 internally).
H_EMA_ALPHA=0.0
# RANSAC threshold is in pitch space (cm), not pixels. ~150cm ≈ 5-15px of image
# error depending on zoom; rejects clear mislabels while accepting real keypoints.
RANSAC_REPROJ_THRESH=150.0
MIN_KP=4
MIN_INLIER_RATIO=0.0
MAX_REPROJ_ERR=0.0
H_MIN_INLIERS_ABS=0
H_INLIER_HYSTERESIS=0.0
H_MAX_JUMP_M=0.0
H_MIN_KP_SPREAD_PX=0.0
# Optical-flow propagation / state machine: intentionally OFF. They introduced the
# temporal memory that made camera pans worse on this footage.
H_OPTFLOW_BRIDGE=false
H_MAX_PROPAGATION_FRAMES=0

# ---- Output-space (pitch) trajectory cleaning ----
# We never smooth H (that would lock a wrong pose during a pan and block recovery).
# Instead we gate the PROJECTED per-track pitch positions: a sample implying a speed
# above PITCH_VEL_MAX_MPS (players peak ~10-11 m/s) is a pan artifact, so we hold the
# last good position until a plausible sample arrives, then mild-EMA accepted ones.
# Feeds both the radar and the speed/track-map analytics.
PITCH_VEL_MAX_MPS=12.0
PITCH_SMOOTH_ALPHA=0.30
PITCH_SMOOTH_RESET_GAP=60
# Manual homography keyframe anchors (per-video; build with tools/manual_calib.py).
# When set, the frames it covers use the human-clicked / flow-interpolated H
# directly (radar shows "H: MANUAL") and the automatic estimator is bypassed for
# them. Leave blank to run fully automatic. Set per video, e.g.:
#   H_MANUAL_SIDECAR=/content/outputs/manual_h.json
H_MANUAL_SIDECAR=

# ---- 2D radar (top-down pitch, roboflow/sports annotators) ----
# Refresh the radar every N frames and hold it in between to remove dot jitter.
RADAR_EVERY_N=5
RADAR_SCALE=0.1
RADAR_PADDING=50
